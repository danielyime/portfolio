{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/planner",
      "destination": "https://wedding-planner-daniels-projects-b9294faf.vercel.app/planner"
    },
    {
      "source": "/planner/:path*",
      "destination": "https://wedding-planner-daniels-projects-b9294faf.vercel.app/planner/:path*"
    },
    {
      "source": "/((?!planner).*)",
      "destination": "/index.html"
    }
  ]
}
